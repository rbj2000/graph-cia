    // Connect Layer 2 to Layer 1
    MATCH (l2:Aggregation {layer: 2})
    MATCH (l1:Aggregation {layer: 1})
    WITH l2, l1 ORDER BY rand() LIMIT 1
    CREATE (l2)-[:CONNECTED_TO]->(l1)
    

    // Connect Layer 3 to Layer 2
    MATCH (l3:Aggregation {layer: 3})
    MATCH (l2:Aggregation {layer: 2})
    WITH l3, l2 ORDER BY rand() LIMIT 1
    CREATE (l3)-[:CONNECTED_TO]->(l2)
    

    // Connect Modems to Layer 3 for signal
    MATCH (m:Modem)
    MATCH (l3:Aggregation {layer: 3})
    WITH m, l3 ORDER BY rand() LIMIT 1
    CREATE (m)-[:HAS_SIGNAL]->(l3)
    

    // Connect Modems to Layer 3 for power
    MATCH (m:Modem)
    MATCH (l3:Aggregation {layer: 3})
    WITH m, l3 ORDER BY rand() LIMIT 1
    CREATE (m)-[:HAS_POWER]->(l3)
    